<div class="ca2i">
  {{#if systemError}}<p class="ca2i-error" role="alert">{{systemError}}</p>{{/if}}
  {{#if systemWarning}}<p class="ca2i-warning" role="status">{{systemWarning}}</p>{{/if}}

  {{#if report}}
    <h3>{{localize "CA2I.ReportTitle"}}</h3>
    <ul class="ca2i-report">
      {{#each report}}
      <li>
        <strong>{{name}}</strong>{{#if outcome}}: <span class="{{#if failed}}ca2i-error{{/if}}">{{outcome}}</span>{{/if}}
        {{#each packs}}<div class="ca2i-pack {{#if failed}}ca2i-error{{/if}}">{{text}}</div>{{/each}}
        {{#if textOnly.length}}
          <div class="ca2i-textonly">{{localize "CA2I.TextOnly"}}
            <ul>{{#each textOnly}}<li>{{this}}</li>{{/each}}</ul>
          </div>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{#if bookReport}}<p>{{localize "CA2I.LeftAlone"}}</p>{{/if}}
    <footer class="form-footer">
      {{#if bookReport}}
        <button type="button" data-action="openCompendiums"><i class="fa-solid fa-book-atlas"></i> {{localize "CA2I.OpenCompendiums"}}</button>
      {{/if}}
      {{#each report}}{{#if actorId}}
        <button type="button" data-action="openActor" data-actor-id="{{actorId}}"><i class="fas fa-user"></i> {{openLabel}}</button>
      {{/if}}{{/each}}
      <button type="button" data-action="done"><i class="fas fa-check"></i> {{localize "CA2I.Close"}}</button>
    </footer>
  {{else}}
    {{#unless systemError}}
      <label class="ca2i-file">{{localize "CA2I.ChooseFile"}}
        <input type="file" name="file" accept=".json,application/json" {{#if busy}}disabled{{/if}}>
      </label>
      {{#if refused}}<p class="ca2i-error" role="alert">{{refused}}</p>{{/if}}
    {{/unless}}

    {{#if books}}
      <ul class="ca2i-rows">
        {{#each books}}
        <li class="ca2i-row">
          <input type="checkbox" name="book-{{@index}}" {{#unless error}}checked{{else}}disabled{{/unless}} aria-label="{{../bookLabel}}: {{name}}">
          <div class="ca2i-info">
            <strong>{{name}}</strong> <span class="ca2i-date">{{id}} · {{canon}} · {{descriptions}}</span>
            {{#if error}}<div class="ca2i-error">{{error}}</div>{{else}}<div class="ca2i-counts">{{counts}}</div>{{/if}}
          </div>
        </li>
        {{/each}}
        {{#if tableRules}}
        <li class="ca2i-row">
          <input type="checkbox" name="tableRules" checked aria-label="{{tableRules}}">
          <div class="ca2i-info"><strong>{{tableRules}}</strong></div>
        </li>
        {{/if}}
      </ul>
      <p class="ca2i-progress" role="status">{{progress}}</p>
      <footer class="form-footer">
        <button type="button" data-action="import" {{#if busy}}disabled{{/if}}><i class="fas fa-file-import"></i> {{localize "CA2I.Import"}}</button>
      </footer>
    {{/if}}

    {{#if rows}}
      {{#if summary}}<p>{{summary}}</p>{{/if}}
      <label class="ca2i-all">{{localize "CA2I.ApplyAll"}}
        <select name="applyAll">
          <option value="">—</option>
          <option value="replace">{{localize "CA2I.Replace"}}</option>
          <option value="new">{{localize "CA2I.New"}}</option>
          <option value="skip">{{localize "CA2I.Skip"}}</option>
        </select>
      </label>
      <ul class="ca2i-rows">
        {{#each rows}}
        <li class="ca2i-row">
          <input type="checkbox" name="tick-{{@index}}" checked aria-label="{{../includeLabel}}: {{name}}">
          {{#if portrait}}<img src="{{portrait}}" alt="">{{else}}<i class="fas fa-user ca2i-noportrait"></i>{{/if}}
          <div class="ca2i-info">
            <strong>{{name}}</strong>{{#if npc}} <span class="ca2i-date">{{npc}}</span>{{/if}} <span class="ca2i-date">{{exported}}</span>
            {{#if inWorld}}
              <div class="{{#if older}}ca2i-error{{/if}}">{{inWorld}}</div>
              {{#if older}}<div class="ca2i-error">{{localize "CA2I.OlderWarning"}}</div>{{/if}}
              <div class="ca2i-choices">
                {{#each choices}}
                <label><input type="radio" name="choice-{{@../index}}" value="{{value}}" {{#if checked}}checked{{/if}}> {{label}}</label>
                {{/each}}
              </div>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
      <p class="ca2i-progress" role="status">{{progress}}</p>
      <footer class="form-footer">
        <button type="button" data-action="import" {{#if busy}}disabled{{/if}}><i class="fas fa-file-import"></i> {{localize "CA2I.Import"}}</button>
      </footer>
    {{/if}}
  {{/if}}
</div>
